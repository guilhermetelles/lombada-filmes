rules_version = '2';

// ===============================================================
// Lombada: regras de segurança do Firestore
// Protótipo: revisar antes de abrir o app para mais gente.
// ===============================================================
//
// Modelo de dados (detalhes em docs/modelo-de-dados.md)
//
// users/{uid}                       só a própria pessoa lê e grava
//   displayName     string 1–80
//   photoUrl        string https até 500 | null
//   recentListIds   string: ids das listas visitadas, da mais recente para a mais antiga,
//                   separados por vírgula ("L2,L1"), até 200, sem repetição. É texto, e não
//                   lista, porque as regras não conseguem conferir o tipo de cada item de uma lista.
//   activeListId    id 1–64 | null: lista que abre ao iniciar
//   createdAt       timestamp: hora do servidor na criação, imutável
//   updatedAt       timestamp: hora do servidor a cada gravação
//
// lists/{listId}                    membros leem; o app só edita nome e descrição. Criar, entrar,
//                                   sair e apagar passam pelo backend (POST /api/lists e afins).
//   name            string 1–80, não só espaços
//   description     string 0–280
//   ownerUid        string 1–128, imutável
//   memberUids      list<string>: quem lê e edita; só o backend altera (código de convite).
//   source          map, opcional, só o backend grava: origem num export do Letterboxd
//   createdAt       timestamp, imutável
//   updatedAt       timestamp: hora do servidor a cada gravação
//
// lists/{listId}/entries/{entryId}  membros da lista leem, criam, editam e removem
//   tmdbId          int 1–99.999.999, imutável
//   rankKey         string 1–64 [0-9A-Za-z]: chave de ordem fracionária
//   watchedOn       'AAAA-MM-DD' | null
//   comment         string 0–5000
//   addedBy         uid de quem criou, imutável
//   updatedBy       uid de quem gravou por último
//   createdAt       timestamp, imutável
//   updatedAt       timestamp: hora do servidor a cada gravação
//   movie           map, imutável pelo app: cópia resumida de movies/{tmdbId} (o backend atualiza)
//                   { title 1–300, year int 1870–2100 | null, posterPath 0–200 | null,
//                     imdb 0–10 | null, letterboxd 0–5 | null }
//
// invites/{code}                    só o backend
// movies/{tmdbId}, usage/{dia}      logados leem; só o backend grava
//
// O backend usa o Firebase Admin SDK, que não passa por estas regras.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Quem está pedindo
    // ---------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMemberOf(list) {
      return isSignedIn() && request.auth.uid in list.memberUids;
    }

    // Lê a lista-mãe. Se ela não existir, o get falha e o acesso é negado.
    function isListMember(listId) {
      return isMemberOf(get(/databases/$(database)/documents/lists/$(listId)).data);
    }

    // ---------------------------------------------------------------
    // Formato dos campos
    // ---------------------------------------------------------------

    // O documento tem todos os campos obrigatórios e nenhum fora da lista.
    function hasFields(data, required, optional) {
      return data.keys().hasAll(required) && data.keys().hasOnly(required.concat(optional));
    }

    function isText(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    function isTextOrNull(value, minSize, maxSize) {
      return value == null || isText(value, minSize, maxSize);
    }

    function isNumberOrNull(value, min, max) {
      return value == null || (value is number && value >= min && value <= max);
    }

    function isHttpsUrl(value) {
      return isText(value, 9, 500) && value.matches('^https://.*');
    }

    function isId(value) {
      return isText(value, 1, 64) && value.matches('^[A-Za-z0-9_-]+$');
    }

    function isUid(value) {
      return isText(value, 1, 128);
    }

    // Texto com ids separados por vírgula: vazio, ou de 1 a maxCount ids sem repetição.
    function isIdList(value, maxCount) {
      let ids = value.split(',');
      return value is string &&
             value.size() <= maxCount * 65 &&
             (value == '' ||
              (value.matches('^[A-Za-z0-9_-]{1,64}(,[A-Za-z0-9_-]{1,64})*$') &&
               ids.size() <= maxCount &&
               ids.toSet().size() == ids.size()));
    }

    // Data sem hora, AAAA-MM-DD. Confere o formato, não o calendário (aceitaria 2026-02-31).
    function isDate(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    // ---------------------------------------------------------------
    // Alterações (só em update)
    // ---------------------------------------------------------------

    function changedFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function keepsFields(fields) {
      return !changedFields().hasAny(fields);
    }

    function changesOnly(fields) {
      return changedFields().hasOnly(fields);
    }

    // ---------------------------------------------------------------
    // Validadores de documento (usados na criação e na edição)
    // ---------------------------------------------------------------

    function isValidUser(data) {
      return hasFields(data, ['displayName', 'photoUrl', 'recentListIds', 'activeListId', 'createdAt', 'updatedAt'], []) &&
             isText(data.displayName, 1, 80) &&
             (data.photoUrl == null || isHttpsUrl(data.photoUrl)) &&
             isIdList(data.recentListIds, 200) &&
             (data.activeListId == null || isId(data.activeListId)) &&
             data.createdAt is timestamp &&
             data.updatedAt == request.time;
    }

    function isValidList(data) {
      return hasFields(data, ['name', 'description', 'ownerUid', 'memberUids', 'createdAt', 'updatedAt'], ['source']) &&
             isText(data.name, 1, 80) && data.name.trim().size() >= 1 &&
             isText(data.description, 0, 280) &&
             isUid(data.ownerUid) &&
             data.memberUids is list &&
             data.createdAt is timestamp &&
             data.updatedAt == request.time;
    }

    function isValidMovieSnapshot(movie) {
      return movie is map &&
             hasFields(movie, ['title', 'year', 'posterPath', 'imdb', 'letterboxd'], []) &&
             isText(movie.title, 1, 300) &&
             (movie.year == null || (movie.year is int && movie.year >= 1870 && movie.year <= 2100)) &&
             isTextOrNull(movie.posterPath, 0, 200) &&
             isNumberOrNull(movie.imdb, 0, 10) &&
             isNumberOrNull(movie.letterboxd, 0, 5);
    }

    function isValidEntry(data) {
      return hasFields(data, ['tmdbId', 'rankKey', 'watchedOn', 'comment', 'addedBy', 'updatedBy', 'createdAt', 'updatedAt', 'movie'], []) &&
             data.tmdbId is int && data.tmdbId > 0 && data.tmdbId < 100000000 &&
             isText(data.rankKey, 1, 64) && data.rankKey.matches('^[0-9A-Za-z]+$') &&
             (data.watchedOn == null || isDate(data.watchedOn)) &&
             isText(data.comment, 0, 5000) &&
             isUid(data.addedBy) &&
             data.updatedBy == request.auth.uid &&
             data.createdAt is timestamp &&
             data.updatedAt == request.time &&
             isValidMovieSnapshot(data.movie);
    }

    // ---------------------------------------------------------------
    // Regras por coleção
    // ---------------------------------------------------------------

    match /users/{uid} {
      allow read, delete: if isUser(uid);
      allow create: if isUser(uid) &&
                       isValidUser(request.resource.data) &&
                       request.resource.data.createdAt == request.time;
      allow update: if isUser(uid) &&
                       isValidUser(request.resource.data) &&
                       keepsFields(['createdAt']);
    }

    match /lists/{listId} {
      // A consulta "minhas listas" precisa filtrar por memberUids array-contains uid.
      allow read: if isMemberOf(resource.data);

      // Criar passa pelo backend (POST /api/lists), que já gera o primeiro código de convite.
      allow create: if false;

      // Membros editam só nome e descrição. Dono, membros e origem mudam só pelo backend.
      allow update: if isMemberOf(resource.data) &&
                       isValidList(request.resource.data) &&
                       changesOnly(['name', 'description', 'updatedAt']);

      // Excluir apaga também as entradas e os convites: fica com o backend.
      allow delete: if false;

      match /entries/{entryId} {
        // A permissão vem da lista-mãe, então as consultas ordenadas por rankKey ou watchedOn
        // funcionam para membros sem filtro extra.
        allow read, delete: if isListMember(listId);

        allow create: if isListMember(listId) &&
                         isValidEntry(request.resource.data) &&
                         request.resource.data.addedBy == request.auth.uid &&
                         request.resource.data.createdAt == request.time;

        // Membros mudam posição, data e comentário. O filme, quem adicionou, a criação e a
        // cópia resumida do filme não mudam pelo app.
        allow update: if isListMember(listId) &&
                         isValidEntry(request.resource.data) &&
                         keepsFields(['tmdbId', 'addedBy', 'createdAt', 'movie']);
      }
    }

    match /invites/{code} {
      allow read, write: if false;
    }

    match /movies/{tmdbId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /usage/{day} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
